import express from 'express';
import type { Request, Response } from 'express';
import { Service } from '../../models/index.js';

const router = express.Router();

// GET /service - Get all services
router.get('/', async (_req: Request, res: Response) => {
  try {
    const services = await Service.findAll();
    res.status(200).json(services);
  } catch (error) {
    console.error(error); // Log the error
    res.status(500).json({ error: 'Internal Server Error' });
  }
});

// GET /service/:id - Get a service by ID
router.get('/:id', async (req: Request, res: Response) => {
  try {
    const service = await Service.findByPk(req.params.id);
    if (service) {
      res.status(200).json(service);
    } else {
      res.status(404).json({ error: 'Service not found' });
    }
  } catch (error) {
    console.error(error); // Log the error
    res.status(500).json({ error: 'Internal Server Error' });
  }
});

// POST /service - Create a new service
router.post('/', async (req: Request, res: Response) => {
  try {
    const { name, description } = req.body; // Example of checking required fields

    if (!name || !description) {
      return res.status(400).json({ error: 'Name and description are required' });
    }

    const newService = await Service.create(req.body);
    res.status(201).json(newService);
  } catch (error) {
    console.error(error); // Log the error
    res.status(500).json({ error: 'Internal Server Error' });
  }
});

// PUT /service/:id - Update a service by ID
router.put('/:id', async (req: Request, res: Response) => {
  try {
    const service = await Service.findByPk(req.params.id);
    if (service) {
      // Check if the update body is valid
      const { name, description } = req.body;

      if (!name || !description) {
        return res.status(400).json({ error: 'Name and description are required' });
      }

      await service.update(req.body);
      res.status(200).json(service);
    } else {
      res.status(404).json({ error: 'Service not found' });
    }
  } catch (error) {
    console.error(error); // Log the error
    res.status(500).json({ error: 'Internal Server Error' });
  }
});

// DELETE /service/:id - Delete a service by ID
router.delete('/:id', async (req: Request, res: Response) => {
  try {
    const service = await Service.findByPk(req.params.id);
    if (service) {
      await service.destroy();
      res.status(204).send(); // No content returned for successful deletion
    } else {
      res.status(404).json({ error: 'Service not found' });
    }
  } catch (error) {
    console.error(error); // Log the error
    res.status(500).json({ error: 'Internal Server Error' });
  }
});

export { router as serviceRouter };
